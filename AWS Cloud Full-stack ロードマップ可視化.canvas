			"height":80
		},
		{
			"id":"19b69b1c6206b1aa",
			"type":"text",
			"text":"Frontend を再公開（さいこうかい）（build → S3 → CloudFront キャッシュ（Cache）削除（さくじょ））",
			"styleAttributes":{},
