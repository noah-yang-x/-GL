		},
		{
			"id":"40f372123516f750",
			"type":"text",
			"text":"フロントエンド（Frontend）のリモート（Remote）サービス（Service）アドレス（Address）を変更（へんこう）",
			"styleAttributes":{},
			"x":26723,
