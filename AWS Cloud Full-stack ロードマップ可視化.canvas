	"nodes":[
		{"id":"pg_system_container","type":"group","x":22240,"y":3320,"width":4760,"height":1730,"label":"db コンテナー（Container）｜公式（こうしき）Docker イメージ（Image）から作成（さくせい）して起動（きどう）したもの。以下（いか）のプログラム（Program）はすべてこのコンテナー（Container）内（ない）で動作（どうさ）する。"},
		{"id":"complete_web_runtime","type":"group","x":3160,"y":240,"width":3920,"height":1390,"label":"AWS 上（じょう）で動作（どうさ）する Python バックエンド（Backend）の Docker コンテナー（Container）"},
